# Copy to .env and fill in. Never commit .env.

# Gemini API key (needed from Phase 5, Advisor). Only de-identified business descriptions are sent.
GEMINI_API_KEY=
# Optional: force a model (otherwise the newest available 'flash' model is chosen)
# GEMINI_MODEL=
# Optional: comma-separated backup models tried if the main one is overloaded
# GEMINI_FALLBACK_MODELS=

# "Today" for date-based KYC checks (dataset README says 2026-07-15).
APNASAATHI_TODAY=2026-07-15

# Optional overrides
# APNASAATHI_DB_PATH=backend/apnasaathi.db
# APNASAATHI_DATA_DIR=backend/data

# Smart KYC (Phase 7)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# KYC_ENCRYPTION_KEY=   (optional; otherwise a key is created in backend/.kyc_key)
# KYC_RETENTION_DAYS=30
